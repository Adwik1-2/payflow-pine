# Copy to .env and fill in ONE provider key. Without a key the app uses an offline mock model.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Claude through Microsoft Foundry (Azure): use the Azure key above and your resource URL,
# and set the model names to your Foundry DEPLOYMENT names.
# ANTHROPIC_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# LLM_MODEL_VISION=<your sonnet deployment>
# LLM_MODEL_REASONING=<your sonnet deployment>
# LLM_MODEL_FAST=<your haiku deployment>

# Optional overrides
# LLM_PROVIDER=anthropic        # anthropic | openai | gemini | mock | off
# LLM_MODEL_VISION=claude-sonnet-5-5
# LLM_MODEL_REASONING=claude-sonnet-5-5
# LLM_MODEL_FAST=claude-haiku-5-5
# LLM_TIMEOUT_S=60
